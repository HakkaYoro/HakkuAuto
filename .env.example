# Port of the web UI + API (docker-compose maps host PORT -> container 3000)
PORT=3000

# Where the SQLite database lives (Docker volume mountpoint)
DATA_DIR=/data

# Minutes between automatic source scans
SCAN_MINUTES=30

# Pause between redemptions of the same game, in milliseconds (be nice to the official sites)
REDEEM_DELAY_MS=1500

# Set to false to skip the automatic scan right after boot
STARTUP_SCAN=true

# Shared secret for the API (optional). When set, every /api request must send
# the X-API-Token header — the web UI asks for it once and stores it in the browser.
# API_TOKEN=set-me-if-your-lan-is-shared
