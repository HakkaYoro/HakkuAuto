{
  "name": "hakku-auto",
  "version": "0.1.0",
  "description": "Gacha game code scraper + auto-redeemer (Blue Archive, Stella Sora, ...)",
  "private": true,
  "type": "commonjs",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "concurrently -k -n server,webui -c blue,magenta \"npm:dev:server\" \"npm:dev:webui\"",
    "dev:server": "concurrently -k -n tsc,node -c yellow,green \"tsc -w -p tsconfig.build.json\" \"node --watch dist/main.js\"",
    "dev:webui": "vite -c webui/vite.config.ts",
    "build": "npm run build:server && npm run build:webui",
    "build:server": "tsc -p tsconfig.build.json",
    "build:webui": "tsc -p webui/tsconfig.json && vite build -c webui/vite.config.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "i18next": "^26.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.11",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
